[Unit]
Description=Fires 5min after boot to check if WiFi-wipe AP provisioning completed; restores backup if not

[Timer]
# DEV-MODE TIMER VALUE. Set to 5min so the developer doesn't have to
# re-flash the Pi between captive-portal iterations: skip the portal,
# wait 5 minutes, the Pi restores its backed-up "home WiFi" profile
# (e.g. Suburban Living) and reboots back onto reachable network.
#
# BEFORE SHIPPING A PI TO A CUSTOMER, revert this to 24h. Customer
# flow itself takes ~3 minutes (AP up, join, captive portal, rejoin
# home WiFi); 24h is the safety-net for the rare case AP mode fails
# to come up after a wipe and we'd otherwise need physical SD-card
# access to recover. 5 minutes is too tight for a real install
# attempt and would auto-revert mid-provisioning.
OnBootSec=30min
# Fire exactly once per boot; don't re-trigger.
Persistent=false
RandomizedDelaySec=0

[Install]
WantedBy=timers.target
