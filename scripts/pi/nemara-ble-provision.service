[Unit]
Description=Nemara camera BLE WiFi provisioning daemon
# Run BEFORE NetworkManager comes online, so a freshly-imaged Pi
# with no saved WiFi sits in BLE-advertise mode until the caregiver
# writes credentials. Once the daemon has provisioned WiFi, it
# touches /var/lib/nemara/provisioned and exits; subsequent boots
# short-circuit because the marker exists OR nmcli already has a
# WiFi connection saved.
After=bluetooth.service dbus.service
Wants=bluetooth.service

[Service]
Type=simple
# Must run as root to use BlueZ via D-Bus on most distros.
User=root
EnvironmentFile=-/etc/nemara/ble.env
ExecStart=/usr/bin/python3 /opt/nemara/ble_provision.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
