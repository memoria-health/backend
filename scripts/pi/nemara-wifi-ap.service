[Unit]
Description=Nemara camera WiFi AP-mode provisioning supervisor
# Run AFTER NetworkManager is up, since we use nmcli to bring the
# AP up and down. The daemon is a long-running supervisor (post
# bugfix): it periodically re-checks the provisioned state and
# brings the AP back up whenever the marker file disappears, so a
# customer-initiated factory reset (rm /var/lib/nemara/provisioned)
# rearms the AP within ~30 s without a reboot.
After=NetworkManager.service dbus.service
Wants=NetworkManager.service

[Service]
Type=simple
# Must run as root to manage WiFi via nmcli + bind to port 80.
User=root
EnvironmentFile=-/etc/nemara/wifi-ap.env
ExecStart=/usr/bin/python3 /opt/nemara/wifi_ap_provision.py
# Always restart: the supervisor is meant to run for the lifetime of
# the device. Even on clean exit (which only happens via SIGINT in
# practice now that the loop is permanent), systemd brings it back
# so a manual `systemctl stop` is the only way to keep it down.
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
