# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Env
# .env is intentionally tracked in this PRIVATE repo so partner clones
# work out-of-the-box. Move it back to gitignored before flipping the
# repo public — all secrets in it (LiveKit keys, Gemini/OpenAI keys,
# APNs .p8 contents) need rotation in that case.
.env.local

# Local-start.sh runtime state (PIDs + log files for backend + ngrok)
.dev/

# Supabase local
supabase/.branches
supabase/.temp

# macOS
.DS_Store

# IDE
.vscode/
.idea/

# Coverage
.coverage
htmlcov/

# runtime log from local dev
.prod-server.log
