# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Env — secrets stay OUT of git. Dev secrets live in a local .env (share
# with teammates via a secret manager / 1Password, not the repo). Prod
# secrets live only in Railway. (.env was previously tracked for partner
# onboarding; it has been untracked and its leaked secrets rotated.)
.env
.env.local

# Local-start.sh runtime state (PIDs + log files for backend + ngrok)
.dev/

# Pipeline / soak output (clips, id-frames, analyses dumps) — local debug
# artifacts, never source. (58 id_frames JPEGs were previously tracked;
# untracked 2026-07-23.)
out/

# Supabase local
supabase/.branches
supabase/.temp

# macOS
.DS_Store

# IDE
.vscode/
.idea/

# Coverage
.coverage
htmlcov/

# runtime log from local dev
.prod-server.log

# Local-only ML model weights (5+ MB binaries, fetched on first
# detector run, not part of source). Keep gitignored even on a
# private repo so clones stay small.
yolo11n.pt
*.pt

# OneDrive/iCloud sync conflict copies. These repos live in a cloud-
# synced folder whose sync daemons spawn "<name> 2.<ext>" duplicate
# files (see CLAUDE.md cloud-sync note). Ignore them so they never
# clutter git status or get committed by accident.
* [2-9].*

# Pod lifecycle secrets (scripts/pod.sh) — never commit
.pod.env
.pod/
