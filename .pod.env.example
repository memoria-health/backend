# Copy to .pod.env (gitignored) and fill in. Consumed by scripts/pod.sh.
# NEVER commit the filled-in .pod.env — it holds the RunPod API key and
# the pod's direct-TCP endpoint.

# RunPod API key (Settings -> API Keys). Grants start/stop/status.
RUNPOD_API_KEY=

# The pod's id (RunPod console URL, or `runpodctl get pod`).
POD_ID=

# Direct-TCP SSH endpoint (RunPod console -> Connect -> "SSH over
# exposed TCP"). RunPod RECYCLES these across tenants, so re-scan the
# host key (below) whenever the pod is recreated.
POD_HOST=
POD_PORT=

# Path to the SSH private key registered with the pod.
POD_SSH_KEY=./.pod/runpod_key

# Path to a PINNED known_hosts for this pod, captured once at setup with:
#   ssh-keyscan -p "$POD_PORT" "$POD_HOST" > ./.pod/pod_known_hosts
# Pinning (not StrictHostKeyChecking=no) is a security requirement: a
# recycled endpoint must NOT silently receive patient frames.
POD_KNOWN_HOSTS=./.pod/pod_known_hosts
