# Copy to .pod.env (gitignored) and fill in. Consumed by scripts/pod.sh.
# NEVER commit the filled-in .pod.env — it holds the RunPod API key, the
# database URL, LiveKit secrets and the identity bearer token.

# ── RunPod account ─────────────────────────────────────────────────────
# API key (Settings -> API Keys). Grants create/start/stop/status.
RUNPOD_API_KEY=

# The current node's id (RunPod console URL, or `runpodctl get pod`).
# `pod.sh release` prints a new one; update this to point the other
# subcommands at it.
POD_ID=

# ── SSH endpoint (managed for you) ─────────────────────────────────────
# Direct-TCP SSH endpoint. RunPod assigns it only once the pod is RUNNING
# and REASSIGNS it across restarts, so these two are stale the moment you
# stop. `pod.sh up` rediscovers them from the API and rewrites them here —
# you should not need to edit them by hand.
POD_HOST=
POD_PORT=

POD_SSH_KEY=./.pod/runpod_key

# PINNED known_hosts. `pod.sh up` re-scans this whenever the endpoint moves.
# Pinning (rather than StrictHostKeyChecking=no) is a security requirement:
# RunPod recycles endpoints across tenants, and a recycled one must NOT
# silently receive patient frames.
POD_KNOWN_HOSTS=./.pod/pod_known_hosts

# ── `pod.sh release` — creating a node from an image ───────────────────
# The image, without a tag. Built by .github/workflows/build-gpu-image.yml.
GHCR_IMAGE=ghcr.io/aryamandarda/memoria-gpu

# The image is PRIVATE (it contains all of src/). Save GHCR credentials in
# RunPod under Settings -> Container Registry Auth and put the id here, or
# every node create fails with an image-pull error.
RUNPOD_REGISTRY_AUTH_ID=

# Network volume id, mounted at /persist. NOT optional:
# at $0 balance RunPod TERMINATES pods WITHOUT a network volume and the data
# is unrecoverable — that is exactly how the first pod died. It also carries
# the ~3.8GB of checkpoints across node recreation.
RUNPOD_NETWORK_VOLUME_ID=

# A network volume is pinned to its datacenter, so the node must be created
# in the same one (e.g. US-KS-2).
RUNPOD_DATACENTER_ID=

# Optional: node name prefix (default nemara-gpu) and acceptable GPUs.
# Comma-separated JSON strings; first available wins.
#RUNPOD_POD_NAME=nemara-gpu
#RUNPOD_GPU_TYPES="NVIDIA A40","NVIDIA RTX A5000"

# ── Node runtime env (baked into the pod at create time) ───────────────
# Identity reads the face-enrollment gallery from Postgres.
NEMARA_DB_URL=

# Identity subscribes to LiveKit and pulls camera frames itself.
NEMARA_LIVEKIT_URL=
NEMARA_LIVEKIT_API_KEY=
NEMARA_LIVEKIT_API_SECRET=

# Bearer for /state, /probes and /stream. MUST be set and MUST match the
# backend's NEMARA_IDENTITY_STATE_TOKEN. An empty value disables the check
# entirely, which would leave live annotated patient video open to anything
# that reaches the port — the entrypoint refuses to start without it.
NEMARA_IDENTITY_STATE_TOKEN=

# Which homes this node serves, comma-separated. One identity process per
# room, ports 8012, 8013, ... in this order.
# (Phase 3 replaces this with a roster poll against the backend.)
NEMARA_IDENTITY_ROOMS=

# Gated facebook/sam3.1 grounder. Needed on FIRST boot only — after that the
# checkpoint is on the network volume.
HUGGINGFACE_TOKEN=

# ── Optional node env ──────────────────────────────────────────────────
# Tagged, reusable Tailscale auth key. Without it the node has no route
# from Railway.
#TS_AUTHKEY=

# Bearer for perception's /observe and /faces. Unset = no auth, which is
# survivable only while perception is bound to loopback.
#NEMARA_PERCEPTION_TOKEN=

# Passes admitted to perception at once. Default 1 (serialised). Raising to
# 2 is the measured 1.6-1.8x throughput lever, and sets how many homes fit
# on one node — but it is NOT yet latency-validated (see commit 86b88dd).
#NEMARA_PERCEPTION_CONCURRENCY=1
