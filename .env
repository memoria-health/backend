# Local development. Do not commit.
# Generated 2026-05-23 for e2e walkthrough.

# ── Application ──────────────────────────────────────────────────
NEMARA_ENV=local
NEMARA_LOG_LEVEL=DEBUG

# ── Database (local Supabase) ───────────────────────────────────
NEMARA_DB_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54342/postgres

# ── Supabase Auth ────────────────────────────────────────────────
# 127.0.0.1 works for backend talking to Supabase (same Mac).
# local-start.sh overrides this to the LAN IP (10.0.0.20) at runtime
# so iOS devices on the same Wi-Fi can reach Supabase. Falls back to
# this value if no Wi-Fi.
NEMARA_SUPABASE_URL=http://10.0.0.245:54341
NEMARA_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
