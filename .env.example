# Nemara backend environment. Copy to .env and fill local values.

# ── Application ──────────────────────────────────────────────────
NEMARA_ENV=local
NEMARA_LOG_LEVEL=DEBUG

# ── Database (Supabase local — values from `supabase status -o env`) ──
# NOTE: SQLAlchemy uses postgresql+asyncpg:// (not the postgresql:// printed
# by supabase). Port is the DB port (54322), not the API port (54321).
NEMARA_DB_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres

# ── Supabase Auth (caregiver JWT verification) ───────────────────
# Production tokens are ES256, verified via JWKS at <NEMARA_SUPABASE_URL>/auth/v1/.well-known/jwks.json
# Local-dev tokens are HS256, signed with NEMARA_SUPABASE_JWT_SECRET. The verifier accepts both.
NEMARA_SUPABASE_URL=http://127.0.0.1:54321
NEMARA_SUPABASE_PUBLISHABLE_KEY=<from-supabase-status>
NEMARA_SUPABASE_JWT_SECRET=<from-supabase-status>
NEMARA_SUPABASE_SERVICE_ROLE_KEY=<from-supabase-status>

# ── Detector pipeline (Phase 0+) ─────────────────────────────────
# Provider order is Gemini first, OpenAI fallback. Both keys must be
# set in production; tests monkeypatch the provider callables.
NEMARA_GEMINI_API_KEY=<from-aistudio.google.com>
NEMARA_GEMINI_MODEL=gemini-3.5-flash
# Empty = let Gemini pick its own sampling. Set to "1"–"24" to pin.
NEMARA_GEMINI_VIDEO_FPS=
# One of: low | medium | high | (empty for Gemini default).
NEMARA_GEMINI_MEDIA_RESOLUTION=
# minimal | low | medium | high | '' (model default). On 3.5-flash-lite
# minimal/low are measured no-ops (0 thought tokens); only medium/high
# actually reason (2026-08-01).
NEMARA_GEMINI_THINKING_LEVEL=

NEMARA_OPENAI_API_KEY=<from-platform.openai.com>
NEMARA_OPENAI_MODEL=gpt-5.4
NEMARA_OPENAI_FRAMES_FPS=5

# ── LiveKit (Phase 0+) ──────────────────────────────────────────
# Wall-phone publish URL and server-side token minting credentials.
# Get all three from the LiveKit Cloud dashboard.
NEMARA_LIVEKIT_URL=wss://<project>.livekit.cloud
NEMARA_LIVEKIT_API_KEY=<from-livekit-cloud>
NEMARA_LIVEKIT_API_SECRET=<from-livekit-cloud>
# Optional override for the webhook receiver (falls back to LIVEKIT_API_KEY).
NEMARA_LIVEKIT_WEBHOOK_API_KEY=

# ── Identity (GPU nodes) ────────────────────────────────────────
# Shared bearer for the identity /state endpoint. MUST match the value on
# the nodes, where it is also NEMARA_IDENTITY_STATE_TOKEN.
NEMARA_IDENTITY_STATE_TOKEN=

# LOCAL DEV ONLY. The single-node fallback, used when no GPU node has
# registered in the roster. In production nodes register themselves and this
# is ignored — a global URL cannot describe a fleet.
NEMARA_IDENTITY_STATE_URL=http://host.docker.internal:8012

# PRODUCTION (Railway). Identity nodes live on tailnet-only addresses, so
# calls to them go through tailscaled's outbound HTTP proxy. The container
# entrypoint sets this automatically whenever TS_AUTHKEY is present; set it
# here only to override.
#
# HTTP, not socks5: httpx needs the `socksio` package for SOCKS and we do
# not ship it, so a socks5:// value fails at the first identity call.
#NEMARA_IDENTITY_PROXY_URL=http://localhost:1055

# Tagged, reusable Tailscale auth key for THIS container (tag:backend).
# Unset = no tailnet, and identity is reachable only if directly routable.
#TS_AUTHKEY=

# ── Detector subscriber-bot (Phase 2) ──────────────────────────
# The in-process LiveKit subscriber-bot. Webhook-driven; idle until a
# wall phone is paired and publishing. Tunables (defaults are usually
# fine — match the dashboard's tick/window/fps).
NEMARA_LIVEKIT_WORKER_TICK_SECONDS=10
NEMARA_LIVEKIT_WORKER_WINDOW_SECONDS=15
NEMARA_LIVEKIT_WORKER_TARGET_FPS=5
# Wall phones publish motion_state heartbeats every ~5s; backend
# treats anything older than this TTL as "no motion".
NEMARA_LIVEKIT_MOTION_STATE_TTL_SECONDS=15

# ── Pairing flow (Phase 0+) ─────────────────────────────────────
# bcrypt cost factor for the per-camera api_key_hash. 10 matches the
# dashboard. Each clip ingest verifies a bcrypt — bumping costs CPU.
NEMARA_BCRYPT_ROUNDS=10
# Pairing code lifetime (caregiver mints, wall phone has this long to exchange).
NEMARA_PAIRING_CODE_TTL_SECONDS=600
