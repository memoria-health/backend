# Nemara backend environment. Copy to .env and fill local values.

# ── Application ──────────────────────────────────────────────────
NEMARA_ENV=local
NEMARA_LOG_LEVEL=DEBUG

# ── Database (Supabase local — values from `supabase status -o env`) ──
# NOTE: SQLAlchemy uses postgresql+asyncpg:// (not the postgresql:// printed
# by supabase). Port is the DB port (54322), not the API port (54321).
NEMARA_DB_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres

# ── Supabase Auth (caregiver JWT verification) ───────────────────
# Production tokens are ES256, verified via JWKS at <NEMARA_SUPABASE_URL>/auth/v1/.well-known/jwks.json
# Local-dev tokens are HS256, signed with NEMARA_SUPABASE_JWT_SECRET. The verifier accepts both.
NEMARA_SUPABASE_URL=http://127.0.0.1:54321
NEMARA_SUPABASE_PUBLISHABLE_KEY=<from-supabase-status>
NEMARA_SUPABASE_JWT_SECRET=<from-supabase-status>
NEMARA_SUPABASE_SERVICE_ROLE_KEY=<from-supabase-status>
